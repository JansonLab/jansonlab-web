---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

// 默认情况下，根目录 404 采用英文
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout title="{t('404.title')}">
  <section class="relative w-full h-[90vh] flex flex-col items-center justify-center px-6 overflow-hidden bg-[#1a1a1a]">
    
    <!-- 装饰性背景：模拟示波器噪声线或矩阵背景 -->
    <div class="absolute inset-0 opacity-5 pointer-events-none bg-[url('/images/oscilloscope-grid.svg')] bg-repeat"></div>

    <div class="z-10 text-center">
      <!-- 巨大的 404 数字，带有一点点 Vue 绿的渐变 -->
      <h1 class="text-8xl md:text-9xl font-black tracking-tighter mb-4 bg-clip-text text-transparent bg-gradient-to-b from-[#42d392] to-[#647eff] opacity-80">
        404
      </h1>

      <h2 class="text-2xl md:text-3xl font-bold text-white mb-6 tracking-tight">
        {t('404.title')}
      </h2>

      <p class="text-neutral-400 text-lg md:text-xl max-w-md mx-auto mb-10 leading-relaxed">
        {t('404.message')}
      </p>

      <!-- 按钮样式与 HeroSection 保持一致 -->
      <div class="flex justify-center">
        <a 
          href={translatePath('/')} 
          class="flex items-center px-8 py-3 bg-[#42d392] hover:bg-[#33a06f] text-[#213547] font-bold rounded-lg transition-all duration-300 shadow-lg shadow-[#42d392]/20"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          {t('404.button')}
        </a>
      </div>
    </div>

    <!-- 底部点缀：模拟终端的一行字 -->
    <div class="absolute bottom-10 font-mono text-[10px] text-neutral-600 tracking-widest uppercase">
      Status: ERR_SIGNAL_LOST | Location: Unknown_Sector
    </div>

    <!-- 背景光晕 -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-[#647eff]/5 blur-[120px] rounded-full pointer-events-none"></div>
  </section>
</Layout>

<script>
  // 极客小彩蛋：在控制台打印一条错误信息
  console.log("%c Janson Lab %c Signal Lost in Sector 404 ", "color: #1a1a1a; background: #42d392; padding: 5px; border-radius: 3px;", "color: #42d392;");
</script>
